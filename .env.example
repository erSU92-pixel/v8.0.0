# === Wajib ===
TWELVE_DATA_API_KEY=your_key
TELEGRAM_BOT_TOKEN=123456789:AAExample
TELEGRAM_CHAT_ID=-1001234567890

# === Account (match Headway Demo screenshot = $1,000) ===
ACCOUNT_SIZE_USD=1000

# === Risk per trade ===
# RISK_PCT = TARGET risk (bot will floor lot to broker min)
# MAX_LOT_RISK_PCT = HARD CEILING. If min lot 0.01 would exceed this,
#                    the trade is SKIPPED (silently by default).
# For $1,000 XAUUSD: min-lot risk is typically 2-3% — set ceiling to 2.5
#                     (allows most trades) or 3.0 (permissive) or 2.0 (strict).
# For true 1% risk: upgrade to $5,000+ or use a Cent account.
RISK_PCT=1.0
MAX_LOT_RISK_PCT=2.5

# === Kelly (activates only after 20+ closed trades) ===
KELLY_FRACTION=0.5
KELLY_CAP_PCT=3.0

# === Daily DD protection (small account = tighter) ===
DAILY_DD_LIMIT_R=2.0
DAILY_DD_DERISK_R=1.0
DAILY_DD_DERISK_MULT=0.5
CB_HALT_CONSECUTIVE=3

# === Telegram notification verbosity ===
# Default: ONLY valid executable BUY/SELL signals + bot errors.
# Set to 1 to enable additional informational alerts (may be noisy).
NOTIFY_WAIT=0     # 1 = also send WAIT updates every 20min check
NOTIFY_SKIP=0     # 1 = also send min-lot SKIP alerts
NOTIFY_HALT=0     # 1 = also send risk HALT alerts (CB/DD lockout)

# === Supabase (opsional — tanpa ini Kelly tidak aktif) ===
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=signals

# === News ===
NEWS_ENABLED=1
NEWS_CACHE_TTL_MIN=60
